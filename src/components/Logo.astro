---
/* The mark: two overlapping circles held in balance. Sāmya, equipoise. */
interface Props { class?: string; light?: boolean }
const { class: cls = '', light = false } = Astro.props;
const id = `lg-${Math.random().toString(36).slice(2, 7)}`;
---
<span class:list={['logo', cls, { light }]}>
  <svg viewBox="0 0 40 28" width="40" height="28" aria-hidden="true">
    <defs>
      <linearGradient id={`${id}a`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#5FA595" />
        <stop offset="1" stop-color="#A9D9CC" />
      </linearGradient>
      <linearGradient id={`${id}b`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#F2B49E" />
        <stop offset="1" stop-color="#F9D3BE" />
      </linearGradient>
    </defs>
    <circle cx="14" cy="14" r="11" fill={`url(#${id}a)`} />
    <circle cx="26" cy="14" r="11" fill={`url(#${id}b)`} style="mix-blend-mode:multiply" opacity=".9" />
  </svg>
  <span class="word">samya</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: .55rem; }
  .logo :global(svg) { width: 2.1rem; height: auto; flex: none; }
  .word {
    font-family: var(--font-display);
    font-size: 1.75rem; line-height: 1; letter-spacing: -0.01em;
    color: var(--ink);
    transform: translateY(-1px);
  }
  .light .word { color: #fff; }
</style>
