---
import Icon from './Icon.astro';
interface Props {
  t: { name: string; context: string; quote: string; excerpt?: string };
  tone?: 'light' | 'dark' | 'tinted';
  size?: 'md' | 'lg';
  excerpt?: boolean;
  class?: string;
}
const { t, tone = 'light', size = 'md', excerpt = false, class: cls = '' } = Astro.props;
const text = excerpt && t.excerpt ? t.excerpt : t.quote;
const initials = t.name.split(' ').map((w) => w[0]).join('').slice(0, 2);
---
<figure class:list={['tm', `tone-${tone}`, `size-${size}`, cls]}>
  <span class="mark" aria-hidden="true"><Icon name="quote" /></span>
  <blockquote><p>{text}</p></blockquote>
  <figcaption>
    <span class="avatar" aria-hidden="true">{initials}</span>
    <span><strong>{t.name}</strong><small>{t.context}</small></span>
  </figcaption>
</figure>

<style>
  .tm {
    margin: 0; position: relative;
    display: flex; flex-direction: column; gap: 1.5rem;
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    border-radius: var(--r-card);
  }
  .tone-light { background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-soft); }
  .tone-tinted { background: rgba(255,255,255,.55); border: 1px solid rgba(255,255,255,.9); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); }
  .tone-dark { background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.14); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); color: #EEF4F2; }
  .mark {
    width: 3rem; height: 3rem; border-radius: 50%; display: grid; place-items: center;
    background: var(--g-cta); color: #fff;
  }
  .mark :global(svg) { width: 1.4rem; height: 1.4rem; }
  blockquote { margin: 0; }
  blockquote p { font-family: var(--font-display); font-size: clamp(1.3rem, 1.9vw, 1.6rem); line-height: 1.35; letter-spacing: -.005em; }
  .size-lg blockquote p { font-size: clamp(1.5rem, 2.6vw, 2.2rem); line-height: 1.25; }
  figcaption { display: flex; align-items: center; gap: .85rem; margin-top: auto; }
  .avatar {
    width: 2.75rem; height: 2.75rem; border-radius: 50%; display: grid; place-items: center;
    background: linear-gradient(135deg, var(--lilac), var(--rose)); color: var(--ink);
    font-weight: 600; font-size: .875rem;
  }
  figcaption strong { display: block; font-weight: 500; }
  figcaption small { display: block; font-size: .8125rem; opacity: .75; }
</style>
