---
import Icon from './Icon.astro';
interface Props {
  t: { name: string; context: string; quote: string; excerpt?: string };
  tone?: 'light' | 'dark' | 'tinted';
  size?: 'md' | 'lg';
  excerpt?: boolean;
  class?: string;
}
const { t, tone = 'light', size = 'md', excerpt = false, class: cls = '' } = Astro.props;
const text = excerpt && t.excerpt ? t.excerpt : t.quote;
const initials = t.name.split(' ').map((w) => w[0]).join('').slice(0, 2);
---
<figure class:list={['tm', `tone-${tone}`, `size-${size}`, cls]}>
  <span class="mark" aria-hidden="true"><Icon name="quote" /></span>
  <blockquote><p>{text}</p></blockquote>
  <figcaption>
    <span class="avatar" aria-hidden="true">{initials}</span>
    <span class="meta">
      <strong>{t.name}</strong>
      {t.context && <small>{t.context}</small>}
    </span>
  </figcaption>
</figure>

<style>
  .tm {
    margin: 0; position: relative;
    display: flex; flex-direction: column; gap: 1rem;
    padding: clamp(1.4rem, 2.5vw, 1.9rem);
    border-radius: var(--r-card);
  }
  .tone-light { background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-soft); }
  .tone-tinted { background: rgba(255,255,255,.55); border: 1px solid rgba(255,255,255,.9); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); }
  .tone-dark { background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.14); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); color: #EEF4F2; }
  .mark {
    width: 2rem; height: 2rem; border-radius: 50%; display: grid; place-items: center;
    background: color-mix(in srgb, currentColor 8%, transparent);
    color: currentColor; opacity: .6;
  }
  .mark :global(svg) { width: .95rem; height: .95rem; }
  blockquote { margin: 0; }
  blockquote p { font-size: 1rem; line-height: 1.6; color: inherit; opacity: .9; }
  .size-lg blockquote p { font-size: 1.125rem; line-height: 1.55; }
  figcaption { display: flex; align-items: center; gap: .75rem; margin-top: auto; }
  .avatar {
    width: 2.25rem; height: 2.25rem; border-radius: 50%; display: grid; place-items: center;
    background: linear-gradient(135deg, var(--lilac), var(--rose)); color: var(--ink);
    font-weight: 600; font-size: .75rem;
  }
  .meta { display: grid; gap: .1rem; }
  figcaption strong { font-weight: 600; font-size: .9375rem; }
  figcaption small { font-size: .8125rem; opacity: .6; }
</style>
