---
import { marked } from 'marked';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../config/site';
import { services } from '../../data/services';
import { getPost, readMinutes, formatDate, CACHE } from '../../data/blog';

export const prerender = false;

const post = await getPost(Astro.params.slug ?? '');
if (!post) return Astro.rewrite('/404');
Astro.response.headers.set('Cache-Control', CACHE);

// Written in /admin by signed-in admins only, so the Markdown is trusted.
const html = await marked.parse(post.content.trim());
const service = services.find((s) => s.slug === post.service);
const ogImage = new URL(post.cover_url, Astro.site ?? site.url).href;
---

<Base ogImage={ogImage} ogAlt={post.cover_alt} title={post.title} description={post.description}>
  <article>
    <header class="a-head">
      <div class="wrap-narrow a-head-inner">
        <a href="/blog" class="back small reveal"><Icon name="arrow-left" />All posts</a>
        <h1 class="h1 reveal" style="--d:60ms">{post.title}</h1>
        <p class="lead reveal" style="--d:120ms">{post.description}</p>
        <p class="meta small reveal" style="--d:180ms">By {site.practitioner} · {formatDate(post.published_on)} · {readMinutes(post)} min read</p>
      </div>
      <div class="wrap a-photo reveal" style="--d:220ms">
        <img src={post.cover_url} alt={post.cover_alt} class="photo-fill" loading="eager" fetchpriority="high" />
      </div>
    </header>

    <div class="wrap-narrow prose" set:html={html} />

    {service && (
      <aside class="wrap-narrow next">
        <a href={`/services/${service.slug}`} class="next-card" style={`background: linear-gradient(135deg, ${service.theme.a}, ${service.theme.b}, ${service.theme.c})`}>
          <span class="small">Want to talk it through?</span>
          <strong class="h3">{service.title}</strong>
          <span class="link-arrow">How I can help <Icon name="arrow" /></span>
        </a>
      </aside>
    )}
  </article>

  <CtaBand />
</Base>

<style>
  .a-head { padding: clamp(8rem, 14vw, 10rem) 0 0; background: var(--g-soft); }
  .a-head-inner { display: grid; gap: 1.1rem; justify-items: start; max-width: 44rem; }
  .a-head .h1 { font-size: clamp(2.1rem, 4.2vw, 3.4rem); }
  .back { display: inline-flex; align-items: center; gap: .4rem; color: var(--violet-deep); text-decoration: none; font-weight: 500; }
  .back :global(svg) { width: 1rem; height: 1rem; transition: transform var(--t-fast) var(--ease-out); }
  .back:hover :global(svg) { transform: translateX(-3px); }
  .meta { color: var(--ink-3); }
  .a-photo { margin-top: clamp(2rem, 5vw, 3.5rem); aspect-ratio: 21 / 9; border-radius: var(--r-photo); overflow: hidden; box-shadow: var(--shadow-lift); transform: translateY(2rem); }

  /* The post body comes from Markdown, so its elements are styled through :global. */
  .prose { max-width: 44rem; padding: calc(var(--section-y) * .75) 0 calc(var(--section-y) * .5); display: grid; gap: 1.15rem; }
  .prose :global(p), .prose :global(li) { color: var(--ink-2); }
  .prose > :global(p:first-child) { font-family: var(--font-display); font-size: var(--fs-h3); line-height: 1.35; color: var(--ink); }
  .prose :global(h2) { font-family: var(--font-display); font-weight: 360; font-size: var(--fs-h2); letter-spacing: -.02em; line-height: var(--lh-heading); margin-top: 2.25rem; }
  .prose :global(h3) { font-family: var(--font-display); font-weight: 380; font-size: var(--fs-h3); line-height: 1.2; margin-top: 1.25rem; }
  .prose :global(strong) { color: var(--ink); font-weight: 500; }
  .prose :global(em) { color: var(--ink); }
  .prose :global(a) { color: var(--violet-deep); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .prose :global(ul) { list-style: none; display: grid; gap: .65rem; }
  .prose :global(li) { position: relative; padding-left: 1.6rem; }
  .prose :global(img) { width: 100%; height: auto; border-radius: var(--r-photo); margin-block: .75rem; }
  .prose :global(blockquote) { font-family: var(--font-display); font-style: italic; font-size: var(--fs-h3); line-height: 1.4; color: var(--ink); padding-left: 1.25rem; border-left: 2px solid var(--calm-300); }
  .prose :global(li)::before {
    content: ''; position: absolute; left: .2rem; top: .7em; width: .5rem; height: .5rem; border-radius: 50%;
    background: linear-gradient(135deg, var(--calm-300), var(--warm-300));
  }
  .prose > :global(p:last-child) { font-family: var(--font-display); font-style: italic; font-size: var(--fs-h3); line-height: 1.4; color: var(--ink); margin-top: 1rem; padding-top: 1.75rem; border-top: 1px solid var(--line); }

  .next-card { display: grid; gap: .5rem; justify-items: start; padding: 2rem; border-radius: var(--r-card); text-decoration: none; color: var(--ink); }
  .next-card .small { color: var(--ink-2); }
</style>
