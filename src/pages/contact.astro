---
import Base from '../layouts/Base.astro';
import Aurora from '../components/Aurora.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import face from '../assets/photos/gitanjali-portrait.jpg';
import { site, whatsappHref, telHref } from '../config/site';
---

<Base og="contact" title="Book a session" description={`Reach out to ${site.practitioner} at Samya. WhatsApp, call or email — replies ${site.replyTime}.`} hideBar>
  <section class="c-hero" data-hide-bar>
    <Aurora />
    <div class="wrap c-grid">
      <!-- ============ Left: reassurance + primary CTA ============ -->
      <aside class="c-side">
        <h1 class="h1 reveal" style="--d:60ms">Let’s begin, <em class="grad-text">gently.</em></h1>
        <p class="lead reveal" style="--d:100ms">A simple hello is enough. Message me on WhatsApp and I’ll reply {site.replyTime}.</p>
        <div class="who-reply reveal" style="--d:140ms">
          <Image src={face} alt="" widths={[120, 240]} sizes="4rem" class="avatar-img" />
          <span><strong>{site.practitioner}</strong><small>Replies personally, {site.replyTime}</small></span>
        </div>
        <div class="reveal" style="--d:180ms">
          <a href={whatsappHref()} class="btn btn-primary" target="_blank" rel="noopener"><Icon name="whatsapp" />Message on WhatsApp</a>
        </div>
      </aside>

      <!-- ============ Right: direct lines ============ -->
      <aside class="c-extra">
        <div class="direct reveal" style="--d:180ms">
          <a href={whatsappHref()} target="_blank" rel="noopener" class="d-card wa">
            <span class="d-icon"><Icon name="whatsapp" /></span>
            <span><strong>WhatsApp</strong></span>
            <Icon name="arrow-up-right" class="d-go" />
          </a>
          <a href={telHref} class="d-card">
            <span class="d-icon"><Icon name="phone" /></span>
            <span><strong>{site.phoneDisplay}</strong></span>
            <Icon name="arrow-up-right" class="d-go" />
          </a>
          <a href={`mailto:${site.email}`} class="d-card">
            <span class="d-icon"><Icon name="mail" /></span>
            <span><strong>{site.email}</strong></span>
            <Icon name="arrow-up-right" class="d-go" />
          </a>
          <a href={site.linkedin} target="_blank" rel="noopener" class="d-card li">
            <span class="d-icon"><Icon name="linkedin" /></span>
            <span><strong>LinkedIn</strong></span>
            <Icon name="arrow-up-right" class="d-go" />
          </a>
          <a href={site.instagram} target="_blank" rel="noopener" class="d-card ig">
            <span class="d-icon"><Icon name="instagram" /></span>
            <span><strong>Instagram</strong></span>
            <Icon name="arrow-up-right" class="d-go" />
          </a>
        </div>

        <p class="crisis reveal" id="urgent">
          <Icon name="lifebuoy" />
          <span><strong>In crisis?</strong> Call {site.crisis.serviceName} on
          <a href={`tel:${site.crisis.numbers[0]}`}>{site.crisis.numbers[0]}</a> (free, 24×7) or emergency services on
          <a href={`tel:${site.crisis.emergency}`}>{site.crisis.emergency}</a>.</span>
        </p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .c-hero { position: relative; overflow: hidden; isolation: isolate; background: var(--g-soft); padding: clamp(7.5rem, 13vw, 9rem) 0 clamp(4rem, 8vw, 6rem); min-height: 100svh; }
  .c-grid { position: relative; z-index: 1; display: grid; gap: 2.5rem; align-items: start; grid-template-areas: "head" "extra"; }
  .c-side { grid-area: head; }
  .c-extra { grid-area: extra; display: grid; gap: 1.4rem; }
  .c-side { display: grid; gap: 1.4rem; justify-items: start; }
  .c-side .lead { max-width: 32rem; }
  .who-reply { display: flex; align-items: center; gap: .85rem; }
  .who-reply :global(.avatar-img) { width: 3.5rem; height: 3.5rem; border-radius: 50%; object-fit: cover; object-position: 50% 22%; border: 3px solid #fff; box-shadow: var(--shadow-soft); }
  .who-reply strong { display: block; font-weight: 500; }
  .who-reply small { display: block; font-size: .8125rem; color: var(--ink-3); }
  .direct { display: grid; gap: .6rem; margin-top: .5rem; }
  .d-card {
    display: flex; align-items: center; gap: 1rem; padding: .9rem 1.1rem; border-radius: 1.25rem;
    background: rgba(255,255,255,.7); border: 1px solid #fff; text-decoration: none;
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    transition: transform .3s var(--ease-out), box-shadow .3s;
  }
  .d-card:hover { transform: translateX(4px); box-shadow: var(--shadow-soft); }
  .d-card > span:nth-child(2) { flex: 1; min-width: 0; }
  .d-card strong { display: block; font-weight: 500; overflow-wrap: anywhere; }
  .d-card small { display: block; font-size: .8125rem; color: var(--ink-3); }
  .d-icon { flex: none; width: 2.75rem; height: 2.75rem; border-radius: 50%; display: grid; place-items: center; background: var(--bg-2); color: var(--violet-deep); }
  .wa .d-icon { background: #DFF7E8; color: #0E7A3F; }
  .li .d-icon { background: #E3EDF8; color: #0A66C2; }
  .ig .d-icon { background: #FDE7EF; color: #C13584; }
  .d-card :global(.d-go) { color: var(--ink-3); }
  .crisis { display: flex; gap: .75rem; padding: 1rem 1.15rem; border-radius: 1.1rem; background: #FCEFEA; border: 1px solid #F6D7CC; font-size: .875rem; color: var(--ink-2); scroll-margin-top: 7rem; }
  .crisis :global(svg) { flex: none; width: 1.3rem; height: 1.3rem; color: var(--magenta); margin-top: .1rem; }
  .crisis a { font-weight: 600; color: var(--ink); }

  @media (min-width: 64rem) { .c-grid { grid-template-columns: 1.1fr .9fr; grid-template-areas: "head extra"; column-gap: 4.5rem; align-items: center; } }
</style>
