---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Aurora from '../../components/Aurora.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services } from '../../data/services';
---

<Base title="Services" description="Grief counselling, child and adolescent counselling, family therapy, existential counselling, anger and emotional regulation, and anxiety and stress counselling at Samya.">
  <section class="sv-hero">
    <Aurora />
    <div class="wrap sv-hero-inner">
      <h1 class="h1 reveal">How I can <em class="grad-text">help</em></h1>
      <ul class="jump reveal" style="--d:180ms">
        {services.map((s) => (
          <li><a href={`#${s.slug}`} class="chip" style={`--a:${s.theme.a};--b:${s.theme.b}`}><span class="dot" />{s.short}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap rows">
      {services.map((s, i) => (
        <article id={s.slug} class:list={['row', { flip: i % 2 === 1 }]} style={`--a:${s.theme.a};--b:${s.theme.b};--c:${s.theme.c};--acc:${s.theme.accent};--tink:${s.theme.ink}`}>
          <a href={`/services/${s.slug}`} class="row-media reveal" tabindex="-1" aria-hidden="true">
            <Image src={s.photo} alt="" widths={[480, 800, 1100]} sizes="(min-width: 60rem) 46vw, 92vw" class="photo-fill" />
            <span class="row-num">{String(i + 1).padStart(2, '0')}</span>
          </a>
          <div class="row-copy">
            <h2 class="h2 reveal">{s.title}</h2>
            <p class="row-tag reveal">{s.tagline}</p>
            <ul class="row-list reveal">
              {s.list.slice(0, 3).map((l) => <li><Icon name="check" />{l}</li>)}
            </ul>
            <div class="row-actions reveal">
              <a href={`/services/${s.slug}`} class="btn btn-primary">Explore {s.short.toLowerCase()} <Icon name="arrow" /></a>
              <a href={`/contact?service=${s.slug}`} class="link-arrow">Book for this <Icon name="arrow" /></a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <a href="/#finder" class="unsure reveal">
        <span class="unsure-orb" aria-hidden="true"></span>
        <span>
          <strong class="h3">Not sure which fits?</strong>
        </span>
        <span class="unsure-go" aria-hidden="true"><Icon name="arrow" /></span>
      </a>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .sv-hero { position: relative; overflow: hidden; isolation: isolate; background: var(--g-soft); padding: clamp(8rem, 14vw, 10rem) 0 clamp(3rem, 6vw, 4.5rem); }
  .sv-hero-inner { position: relative; z-index: 1; display: grid; gap: 1.4rem; justify-items: start; }
  .sv-hero .h1 { max-width: 14ch; }
  .sv-hero .lead { max-width: 38rem; }
  .jump { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .5rem; }
  .jump .chip { text-decoration: none; transition: transform .25s var(--ease-out), box-shadow .25s; }
  .jump .chip:hover { transform: translateY(-2px); box-shadow: var(--shadow-soft); }
  .dot { width: .75rem; height: .75rem; border-radius: 50%; background: linear-gradient(135deg, var(--a), var(--b)); }

  .rows { display: grid; gap: clamp(4rem, 8vw, 7rem); padding-block: clamp(2rem, 5vw, 4rem); }
  .row { display: grid; gap: 2rem; align-items: center; scroll-margin-top: 7rem; }
  .row-media {
    position: relative; display: block; aspect-ratio: 5 / 4; border-radius: var(--r-photo); overflow: hidden;
    box-shadow: 0 40px 80px -45px color-mix(in srgb, var(--acc) 80%, transparent);
  }
  .row-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(200deg, transparent 40%, color-mix(in srgb, var(--a) 70%, transparent)); }
  .row-media :global(img) { transition: transform 1.2s var(--ease-out); }
  .row-media:hover :global(img) { transform: scale(1.05); }
  .row-num {
    position: absolute; z-index: 1; left: 1.25rem; bottom: .5rem;
    font-family: var(--font-display); font-size: clamp(4rem, 9vw, 7rem); line-height: 1; color: #fff;
    text-shadow: 0 4px 30px rgba(0,0,0,.15);
  }
  .row-copy { display: grid; gap: 1.1rem; justify-items: start; }
  .row-copy .h2 { color: var(--tink); }
  .row-tag { font-family: var(--font-display); font-style: italic; font-size: clamp(1.3rem, 2vw, 1.6rem); line-height: 1.3; color: var(--acc); }
  .row-list { list-style: none; display: grid; gap: .6rem; color: var(--ink-2); }
  .row-list li { display: flex; gap: .65rem; align-items: flex-start; }
  .row-list :global(svg) { margin-top: .2rem; color: var(--acc); }
  .row-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: .5rem; }
  .row-actions .link-arrow { color: var(--acc); }
  @media (min-width: 60rem) {
    .row { grid-template-columns: 1fr 1fr; gap: 5rem; }
    .row.flip .row-media { order: 2; }
  }

  .unsure {
    display: flex; align-items: center; gap: 1.5rem; padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--r-card); text-decoration: none; background: var(--g-dawn);
    transition: transform .4s var(--ease-out), box-shadow .4s;
  }
  .unsure:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
  .unsure > span:nth-child(2) { display: grid; gap: .4rem; flex: 1; }
  .unsure-orb { flex: none; width: 4rem; height: 4rem; border-radius: 50%; background: radial-gradient(circle at 30% 30%, #fff, #BFE3D8 45%, #F2B49E); animation: float 7s var(--ease-breath) infinite; }
  .unsure-go { flex: none; width: 3.25rem; height: 3.25rem; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; }
  @media (max-width: 40rem) { .unsure-orb { display: none; } }
</style>
